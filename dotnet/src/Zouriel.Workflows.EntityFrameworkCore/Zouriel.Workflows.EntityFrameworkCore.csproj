<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Entity Framework Core storage for Zouriel Workflows: workflow tables in your own DbContext, a SaveChanges interceptor that turns record changes into workflow triggers through a transactional outbox, and lifecycle field ownership.</Description>
    <PackageTags>workflow;efcore;outbox;audit</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zouriel.Workflows\Zouriel.Workflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zouriel.Workflows.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
