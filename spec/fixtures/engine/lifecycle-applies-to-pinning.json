{
 "name": "Lifecycle applies to, pinning: field ownership follows the lifecycle a record is pinned to even after the condition's field changes; naming another lifecycle is refused (wrongLifecycle) and never starts a second instance; archiving the pinned lifecycle leaves the field without one for that record, and restoring resumes the same instance",
 "registry": "_registry.json",
 "users": "_users.json",
 "records": { "application": [] },
 "definitions": [
  {
   "specVersion": 1, "id": "lc_pass", "key": "passportApplication", "kind": "lifecycle", "title": "Passport application", "entity": "application",
   "lifecycle": {
    "field": "status", "mode": "observe",
    "appliesWhen": { "match": "all", "conditions": [ { "ref": "entity.track", "op": "eq", "value": { "const": "passport" } } ] },
    "states": [
     { "id": "p_draft", "key": "draft", "label": "Draft", "category": "initial" },
     { "id": "p_rev", "key": "underReview", "label": "Checking the passport", "category": "active" },
     { "id": "p_ok", "key": "approved", "label": "Issued", "category": "terminal" }
    ],
    "transitions": [
     { "id": "p_t1", "key": "checkPassport", "label": "Check passport", "from": ["p_draft"], "to": "p_rev", "who": [ { "field": "entity.applicant" } ] },
     { "id": "p_t2", "key": "issue", "label": "Issue", "from": ["p_rev"], "to": "p_ok", "who": [ { "role": "admin" } ] }
    ]
   }
  },
  {
   "specVersion": 1, "id": "lc_any", "key": "generalApplication", "kind": "lifecycle", "title": "General application", "entity": "application",
   "lifecycle": {
    "field": "status", "mode": "enforce",
    "states": [
     { "id": "g_draft", "key": "draft", "label": "Draft", "category": "initial" },
     { "id": "g_sub", "key": "submitted", "label": "Submitted", "category": "active" },
     { "id": "g_done", "key": "approved", "label": "Approved", "category": "terminal" }
    ],
    "transitions": [
     { "id": "g_t1", "key": "submit", "label": "Submit", "from": ["g_draft"], "to": "g_sub", "who": [ { "field": "entity.applicant" } ] }
    ],
    "reset": { "who": [ { "role": "admin" } ] }
   }
  },
  {
   "specVersion": 1, "id": "wf_skip", "key": "moveSkip", "kind": "automation", "title": "Move (skip)", "entity": "application",
   "trigger": { "type": "manual", "label": "Move" },
   "steps": [ { "id": "mv", "type": "applyTransition", "lifecycle": "passportApplication", "transition": "checkPassport", "ifNotAllowed": "skip" } ]
  },
  {
   "specVersion": 1, "id": "wf_fail", "key": "moveFail", "kind": "automation", "title": "Move (fail)", "entity": "application",
   "trigger": { "type": "manual", "label": "Move" },
   "steps": [ { "id": "mv2", "type": "applyTransition", "lifecycle": "passportApplication", "transition": "checkPassport" } ]
  }
 ],
 "steps": [
  { "create": { "entity": "application", "id": "a1", "values": { "title": "Passport", "track": "passport", "applicant": "ali" } } },
  { "create": { "entity": "application", "id": "a2", "values": { "title": "Visa", "track": "visa", "applicant": "ali" } } },
  { "change": { "entity": "application", "id": "a1", "values": { "track": "visa" } } },
  {
   "change": { "entity": "application", "id": "a1", "values": { "status": "underReview" } },
   "expect": {
    "record": { "entity": "application", "id": "a1", "values": { "status": "underReview" } },
    "instanceKinds": ["record"],
    "instances": [
     { "definition": "passportApplication", "record": "a1", "state": "underReview", "status": "active" },
     { "definition": "generalApplication", "record": "a2", "state": "draft" }
    ]
   }
  },
  { "change": { "entity": "application", "id": "a2", "values": { "track": "passport" } } },
  { "change": { "entity": "application", "id": "a2", "values": { "status": "submitted" } }, "expectError": "fieldOwned" },
  { "transition": { "entity": "application", "id": "a2", "transition": "checkPassport", "actor": "ali", "lifecycle": "passportApplication" }, "expectError": "wrongLifecycle" },
  { "forceState": { "entity": "application", "id": "a2", "state": "approved", "reason": "x", "actor": "admin", "lifecycle": "passportApplication" }, "expectError": "wrongLifecycle" },
  { "reset": { "entity": "application", "id": "a1", "actor": "admin", "lifecycle": "generalApplication" }, "expectError": "wrongLifecycle" },
  {
   "manual": { "workflow": "moveSkip", "entity": "application", "id": "a2", "actor": "admin" },
   "expect": { "outputs": { "moveSkip": { "mv": { "applied": false } } } }
  },
  {
   "manual": { "workflow": "moveFail", "entity": "application", "id": "a2", "actor": "admin" },
   "expect": {
    "instances": [
     { "definition": "passportApplication", "record": "a1" },
     { "definition": "generalApplication", "record": "a2", "state": "draft" },
     { "definition": "moveSkip", "status": "completed" },
     { "definition": "moveFail", "status": "incident" }
    ]
   }
  },
  { "archive": "passportApplication" },
  {
   "change": { "entity": "application", "id": "a1", "values": { "status": "approved" } },
   "expect": {
    "record": { "entity": "application", "id": "a1", "values": { "status": "approved" } },
    "available": { "entity": "application", "id": "a1", "user": "admin", "transitions": [] }
   }
  },
  { "create": { "entity": "application", "id": "a3", "values": { "title": "Passport 2", "track": "passport", "applicant": "ali" } } },
  {
   "restore": "passportApplication",
   "expect": {
    "instanceKinds": ["record"],
    "instances": [
     { "definition": "passportApplication", "record": "a1", "state": "underReview" },
     { "definition": "generalApplication", "record": "a2", "state": "draft" },
     { "definition": "generalApplication", "record": "a3", "state": "draft" }
    ],
    "available": { "entity": "application", "id": "a1", "user": "admin", "transitions": ["issue"], "state": "underReview" }
   }
  }
 ]
}
