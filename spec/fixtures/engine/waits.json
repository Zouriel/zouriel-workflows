{
  "name": "Waits: a duration (in working time), a date field, a condition on the record (with timeout), and a signal",
  "now": "2026-10-23T16:00:00Z",
  "registry": "_registry.json", "users": "_users.json",
  "settings": { "version": 1, "timeZone": "UTC", "calendar": { "days": ["mon", "tue", "wed", "thu", "fri"], "hours": ["09:00", "17:00"] } },
  "records": { "application": [
    { "id": "a1", "title": "Duration", "stage": "new" },
    { "id": "a2", "title": "Date", "stage": "new", "deadline": "2026-10-29" },
    { "id": "a3", "title": "Condition", "stage": "new" },
    { "id": "a4", "title": "Signal", "stage": "new" } ] },
  "definitions": [
    { "specVersion": 1, "id": "wf_dur", "key": "waitWorking", "kind": "automation", "title": "Wait 2 working hours", "entity": "application",
      "trigger": { "type": "fieldChanged", "field": "stage", "to": ["checked"], "when": { "ref": "entity.title", "op": "eq", "value": { "const": "Duration" } } },
      "steps": [ { "id": "w", "type": "wait", "until": { "type": "duration", "duration": "PT2H", "calendar": "working" } },
                 { "id": "s", "type": "setFields", "values": [ { "field": "decidedAt", "value": { "ref": "now" } } ] } ] },
    { "specVersion": 1, "id": "wf_date", "key": "waitDate", "kind": "automation", "title": "Day before deadline", "entity": "application",
      "trigger": { "type": "fieldChanged", "field": "stage", "to": ["checked"], "when": { "ref": "entity.title", "op": "eq", "value": { "const": "Date" } } },
      "steps": [ { "id": "w", "type": "wait", "until": { "type": "date", "date": { "ref": "entity.deadline" }, "offset": "-P1D", "at": "08:00" } },
                 { "id": "s", "type": "setFields", "values": [ { "field": "decidedAt", "value": { "ref": "now" } } ] } ] },
    { "specVersion": 1, "id": "wf_cond", "key": "waitPaid", "kind": "automation", "title": "Wait until paid", "entity": "application",
      "trigger": { "type": "fieldChanged", "field": "stage", "to": ["checked"], "when": { "ref": "entity.title", "op": "eq", "value": { "const": "Condition" } } },
      "steps": [ { "id": "w", "type": "wait", "until": { "type": "condition", "when": { "ref": "entity.paid", "op": "isTrue" }, "timeout": "P7D",
                   "onTimeout": { "id": "late", "steps": [ { "id": "lt", "type": "setFields", "values": [ { "field": "priority", "value": { "const": "low" } } ] } ] } } },
                 { "id": "s", "type": "setFields", "values": [ { "field": "stage", "value": { "const": "done" } } ] } ] },
    { "specVersion": 1, "id": "wf_sig", "key": "waitSignal", "kind": "automation", "title": "Wait for payment", "entity": "application",
      "trigger": { "type": "fieldChanged", "field": "stage", "to": ["checked"], "when": { "ref": "entity.title", "op": "eq", "value": { "const": "Signal" } } },
      "steps": [ { "id": "w", "type": "wait", "until": { "type": "signal", "signal": "payment.received" } },
                 { "id": "s", "type": "setFields", "values": [ { "field": "amount", "value": { "ref": "steps.w.data.amount" } } ] } ] }
  ],
  "steps": [
    { "change": { "entity": "application", "id": "a1", "values": { "stage": "checked" } }, "expect": { "instances": [ { "definition": "waitWorking", "status": "waiting" } ] } },
    { "advance": "PT1H", "expect": { "record": { "entity": "application", "id": "a1", "values": { "decidedAt": null } } } },
    { "advance": "P3D", "expect": { "record": { "entity": "application", "id": "a1", "values": { "decidedAt": "2026-10-26T10:00:00.000Z" } } } },
    { "change": { "entity": "application", "id": "a2", "values": { "stage": "checked" } },
      "expect": { "record": { "entity": "application", "id": "a2", "values": { "decidedAt": null } } } },
    { "advance": "P2D", "expect": { "record": { "entity": "application", "id": "a2", "values": { "decidedAt": "2026-10-28T08:00:00.000Z" } } } },
    { "change": { "entity": "application", "id": "a3", "values": { "stage": "checked" } } },
    { "change": { "entity": "application", "id": "a3", "values": { "notes": "not yet" } }, "expect": { "record": { "entity": "application", "id": "a3", "values": { "stage": "checked" } } } },
    { "change": { "entity": "application", "id": "a3", "values": { "paid": true } },
      "expect": { "record": { "entity": "application", "id": "a3", "values": { "stage": "done" } }, "outputs": { "waitPaid": { "w": { "timedOut": false } } } } },
    { "change": { "entity": "application", "id": "a4", "values": { "stage": "checked" } } },
    { "signal": { "signal": "payment.received", "entity": "application", "id": "a1", "data": { "amount": 1 } },
      "expect": { "record": { "entity": "application", "id": "a4", "values": { "amount": null } } } },
    { "signal": { "signal": "payment.received", "entity": "application", "id": "a4", "data": { "amount": 250 } },
      "expect": { "record": { "entity": "application", "id": "a4", "values": { "amount": 250 } },
        "instances": [ { "definition": "waitWorking", "status": "completed" }, { "definition": "waitDate", "status": "completed" },
                       { "definition": "waitPaid", "status": "completed" }, { "definition": "waitSignal", "status": "completed" } ] } }
  ]
}
