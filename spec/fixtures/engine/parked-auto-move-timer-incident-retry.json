{
 "name": "An automatic move whose timer keeps failing is parked: the record instance goes to incident with the error, its moves are still offered, and retry re-arms the timer so the move happens",
 "registry": "_registry.json",
 "users": "_users.json",
 "maxTimerAttempts": 2,
 "definitions": [
  {
   "specVersion": 1,
   "id": "lc_x",
   "key": "expiry",
   "kind": "lifecycle",
   "title": "Expiry",
   "entity": "application",
   "lifecycle": {
    "field": "status",
    "states": [
     {
      "id": "d",
      "key": "draft",
      "label": "Draft",
      "category": "initial"
     },
     {
      "id": "s",
      "key": "submitted",
      "label": "Submitted",
      "category": "active"
     },
     {
      "id": "w",
      "key": "withdrawn",
      "label": "Withdrawn",
      "category": "terminal"
     }
    ],
    "transitions": [
     {
      "id": "t1",
      "key": "submit",
      "label": "Submit",
      "from": [
       "d"
      ],
      "to": "s",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     },
     {
      "id": "tx",
      "key": "expire",
      "label": "Expire unsent drafts",
      "from": [
       "d"
      ],
      "to": "w",
      "auto": {
       "after": "PT1H"
      },
      "hidden": true
     }
    ]
   }
  }
 ],
 "steps": [
  {
   "create": {
    "entity": "application",
    "id": "a1",
    "values": {
     "title": "Grant a1"
    }
   },
   "expect": {
    "bookmarks": 1
   }
  },
  {
   "refuse": {
    "writes": [
     "application.status"
    ]
   }
  },
  {
   "advance": "PT1H",
   "expect": {
    "instances": [
     {
      "definition": "expiry",
      "kind": "record",
      "status": "active",
      "state": "draft"
     }
    ],
    "auditCount": {
     "instance.timerFailed": 1
    }
   }
  },
  {
   "advance": "PT5M",
   "expect": {
    "instances": [
     {
      "definition": "expiry",
      "kind": "record",
      "status": "incident",
      "state": "draft",
      "error": "A timer (auto:tx) failed 2 times and was stopped: InvalidOperationException: The database refused writing application.status."
     }
    ],
    "available": {
     "entity": "application",
     "id": "a1",
     "user": "rev1",
     "transitions": [
      "submit"
     ],
     "state": "draft",
     "status": "incident",
     "error": "A timer (auto:tx) failed 2 times and was stopped: InvalidOperationException: The database refused writing application.status."
    },
    "audit": [
     {
      "is": "instance.timerFailed",
      "data": {
       "attempt": 2,
       "parked": true
      }
     },
     "instance.incident"
    ],
    "bookmarks": 1
   }
  },
  {
   "allow": {
    "writes": [
     "application.status"
    ]
   }
  },
  {
   "advance": "P1D",
   "expect": {
    "instances": [
     {
      "status": "incident",
      "state": "draft"
     }
    ],
    "record": {
     "entity": "application",
     "id": "a1",
     "values": {
      "status": "draft"
     }
    }
   }
  },
  {
   "retry": {
    "definition": "expiry"
   },
   "expect": {
    "record": {
     "entity": "application",
     "id": "a1",
     "values": {
      "status": "withdrawn"
     }
    },
    "instances": [
     {
      "definition": "expiry",
      "status": "completed",
      "state": "withdrawn",
      "error": null
     }
    ],
    "audit": [
     "instance.incident",
     {
      "is": "instance.retried",
      "actor": "admin"
     },
     "lifecycle.autoTransitioned"
    ],
    "bookmarks": 0
   }
  }
 ]
}
