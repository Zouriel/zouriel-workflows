   "title": "Application review",
   "entity": "application",
   "lifecycle": {
    "field": "status",
    "mode": "enforce",
    "states": [
     {
      "id": "st_draft",
      "key": "draft",
      "label": "Draft",
      "category": "initial"
     },
     {
      "id": "st_rev",
      "key": "underReview",
      "label": "Under review",
      "category": "active",
      "sla": {
       "within": "P2D",
       "steps": [
        {
         "id": "sla_n",
         "type": "notify",
         "channel": "email",
         "to": [
          {
           "user": "admin"
          }
         ],
         "body": "Review is overdue"
        }
       ],
       "calendar": "working",
       "pauseOnStatus": [
        "st_wait"
       ],
       "pauseOnEvent": [
        "documents.requested"
       ],
       "resumeOnEvent": [
        "documents.received"
       ]
      }
     },
     {
      "id": "st_wait",
      "key": "awaitingInfo",
      "label": "Awaiting information",
      "category": "active"
     },
     {
      "id": "st_hold",
      "key": "onHold",
      "label": "On hold",
      "category": "active"
     },
     {
      "id": "st_ok",
      "key": "approved",
      "label": "Approved",
      "category": "terminal"
     }
    ],
    "transitions": [
     {
      "id": "tr_start",
      "key": "startReview",
      "label": "Start review",
      "from": [
       "st_draft"
      ],
      "to": "st_rev",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     },
     {
      "id": "tr_ask",
      "key": "askInfo",
      "label": "Ask for information",
      "from": [
       "st_rev"
      ],
      "to": "st_wait",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     },
     {
      "id": "tr_recv",
      "key": "received",
      "label": "Information received",
      "from": [
       "st_wait",
       "st_hold"
      ],
      "to": "st_rev",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     },
     {
      "id": "tr_hold",
      "key": "putOnHold",
      "label": "Put on hold",
      "from": [
       "st_wait",
       "st_rev"
      ],
      "to": "st_hold",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     },
     {
      "id": "tr_approve",
      "key": "approve",
      "label": "Approve",
      "from": [
       "st_rev"
      ],
      "to": "st_ok",
      "who": [
       {
        "role": "reviewer"
       }
      ]
     }
    ]
   }
  }
 ],
