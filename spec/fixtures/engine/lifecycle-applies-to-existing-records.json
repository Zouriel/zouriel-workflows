       "op": "eq",
       "value": {
        "const": "passport"
       }
      }
     ]
    },
    "states": [
     {
      "id": "p_d",
      "key": "draft",
      "label": "Draft",
      "category": "initial"
     },
     {
      "id": "p_r",
      "key": "underReview",
      "label": "Review",
      "category": "active"
     },
     {
      "id": "p_ok",
      "key": "approved",
      "label": "Done",
      "category": "terminal"
     }
    ],
    "transitions": [
     {
      "id": "p_t1",
      "key": "review",
      "label": "Review",
      "from": [
       "p_d"
      ],
      "to": "p_r",
      "who": [
       {
        "role": "admin"
       }
      ]
     },
     {
      "id": "p_t2",
      "key": "finish",
      "label": "Finish",
      "from": [
       "p_r"
      ],
      "to": "p_ok",
      "who": [
       {
        "role": "admin"
       }
      ]
     }
    ]
   }
  },
