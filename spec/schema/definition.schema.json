{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zouriel.com/workflows/spec/v1/definition.schema.json",
  "title": "Zouriel workflow definition",
  "type": "object",
  "required": ["specVersion", "id", "key", "kind", "title"],
  "properties": {
    "specVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "key": { "$ref": "#/$defs/key" },
    "kind": { "enum": ["automation", "lifecycle"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "revision": { "type": "integer", "minimum": 0 },
    "entity": { "$ref": "#/$defs/key" },
    "trigger": { "$ref": "#/$defs/trigger" },
    "steps": { "$ref": "#/$defs/steps" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" }, "maxItems": 100 },
    "settings": { "$ref": "#/$defs/workflowSettings" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "automation" } } },
      "then": { "required": ["trigger", "steps"], "not": { "required": ["lifecycle"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "lifecycle" } } },
      "then": { "required": ["entity", "lifecycle"], "not": { "anyOf": [{ "required": ["trigger"] }, { "required": ["steps"] }] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_.]{0,63}$" },
    "tokenPath": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_-]+)*$", "maxLength": 300 },
    "duration": {
      "type": "string",
      "pattern": "^-?P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "calendar": { "enum": ["calendar", "working"] },
    "formDefinition": {
      "description": "A @zouriel/ui form-builder definition (UiFormDefinition, schemaVersion 1).",
      "type": "object",
      "required": ["schemaVersion", "id", "pages"]
    },

    "operand": {
      "oneOf": [
        { "type": "object", "required": ["const"], "properties": { "const": true }, "additionalProperties": false },
        { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/tokenPath" } }, "additionalProperties": false },
        { "type": "object", "required": ["today"], "properties": { "today": { "type": "integer" } }, "additionalProperties": false },
        { "type": "object", "required": ["calc"], "properties": { "calc": { "$ref": "#/$defs/calc" } }, "additionalProperties": false }
      ]
    },
    "calc": {
      "type": "object",
      "required": ["op", "args"],
      "properties": {
        "op": { "enum": ["sum", "subtract", "multiply", "divide", "average", "min", "max", "count", "ageYears", "daysBetween", "concat"] },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/tokenPath" } }, "additionalProperties": false },
              { "type": "object", "required": ["const"], "properties": { "const": { "type": ["number", "string"] } }, "additionalProperties": false },
              { "type": "object", "required": ["calc"], "properties": { "calc": { "$ref": "#/$defs/calc" } }, "additionalProperties": false }
            ]
          }
        },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "template": {
      "oneOf": [
        { "type": "string", "maxLength": 20000 },
        {
          "type": "array",
          "maxItems": 500,
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/tokenPath" } }, "additionalProperties": false }
            ]
          }
        }
      ]
    },

    "operator": {
      "enum": [
        "empty", "notEmpty", "eq", "neq", "contains", "notContains", "startsWith", "endsWith",
        "gt", "gte", "lt", "lte", "between", "before", "after", "onOrBefore", "onOrAfter",
        "anyOf", "noneOf", "includes", "excludes", "includesAny", "includesAll", "countGte", "countLte",
        "isTrue", "isFalse"
      ]
    },
    "conditionOperand": {
      "oneOf": [
        { "type": "object", "required": ["const"], "properties": { "const": true }, "additionalProperties": false },
        { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/tokenPath" } }, "additionalProperties": false },
        { "type": "object", "required": ["today"], "properties": { "today": { "type": "integer" } }, "additionalProperties": false }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["match", "conditions"],
          "properties": {
            "match": { "enum": ["all", "any", "none"] },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "maxItems": 50 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ref", "op"],
          "properties": {
            "ref": { "$ref": "#/$defs/tokenPath" },
            "op": { "$ref": "#/$defs/operator" },
            "value": { "$ref": "#/$defs/conditionOperand" },
            "value2": { "$ref": "#/$defs/conditionOperand" }
          },
          "additionalProperties": false
        }
      ]
    },

    "assignee": {
      "oneOf": [
        { "type": "object", "required": ["role"], "properties": { "role": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["group"], "properties": { "group": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["user"], "properties": { "user": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["field"], "properties": { "field": { "$ref": "#/$defs/tokenPath" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["managerOf"],
          "properties": { "managerOf": { "anyOf": [{ "enum": ["initiator", "assignees"] }, { "$ref": "#/$defs/tokenPath" }] } },
          "additionalProperties": false
        },
        { "type": "object", "required": ["initiator"], "properties": { "initiator": { "const": true } }, "additionalProperties": false }
      ]
    },
    "assignees": { "type": "array", "items": { "$ref": "#/$defs/assignee" }, "maxItems": 50 },
    "recipient": {
      "oneOf": [
        { "$ref": "#/$defs/assignee" },
        { "type": "object", "required": ["email"], "properties": { "email": { "$ref": "#/$defs/template" } }, "additionalProperties": false }
      ]
    },

    "variable": {
      "type": "object",
      "required": ["id", "key", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "number", "boolean", "date", "dateTime", "user", "json"] },
        "default": true
      },
      "additionalProperties": false
    },
    "workflowSettings": {
      "type": "object",
      "properties": {
        "concurrency": { "enum": ["perRecordSerial", "parallel", "skipIfRunning"] },
        "owners": { "$ref": "#/$defs/assignees" },
        "notifyOwnersOnIncident": { "type": "boolean" },
        "calendar": { "$ref": "#/$defs/calendar" }
      },
      "additionalProperties": false
    },

    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["created", "fieldChanged", "stateEntered", "transitionApplied", "deleted", "dateReached", "schedule", "manual", "signal"] },
        "when": { "$ref": "#/$defs/condition" },
        "retrigger": { "type": "boolean" },
        "field": { "$ref": "#/$defs/key" },
        "from": { "type": "array", "items": true, "maxItems": 100 },
        "to": { "type": "array", "items": true, "maxItems": 100 },
        "lifecycle": { "$ref": "#/$defs/key" },
        "states": { "type": "array", "items": { "$ref": "#/$defs/key" }, "minItems": 1 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/key" }, "minItems": 1 },
        "offset": { "$ref": "#/$defs/duration" },
        "at": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "cron": { "type": "string", "minLength": 9, "maxLength": 120 },
        "forEach": {
          "type": "object",
          "properties": { "when": { "$ref": "#/$defs/condition" }, "limit": { "type": "integer", "minimum": 1, "maximum": 500 } },
          "required": ["limit"],
          "additionalProperties": false
        },
        "label": { "type": "string" },
        "form": { "$ref": "#/$defs/formDefinition" },
        "who": { "$ref": "#/$defs/assignees" },
        "signal": { "$ref": "#/$defs/key" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "fieldChanged" } } }, "then": { "required": ["field"] } },
        { "if": { "properties": { "type": { "const": "stateEntered" } } }, "then": { "required": ["lifecycle", "states"] } },
        { "if": { "properties": { "type": { "const": "transitionApplied" } } }, "then": { "required": ["lifecycle", "transitions"] } },
        { "if": { "properties": { "type": { "const": "dateReached" } } }, "then": { "required": ["field", "offset"] } },
        { "if": { "properties": { "type": { "const": "schedule" } } }, "then": { "required": ["cron"] } },
        { "if": { "properties": { "type": { "const": "manual" } } }, "then": { "required": ["label"] } },
        { "if": { "properties": { "type": { "const": "signal" } } }, "then": { "required": ["signal"] } }
      ]
    },

    "lifecycle": {
      "type": "object",
      "required": ["field", "states", "transitions"],
      "properties": {
        "field": { "$ref": "#/$defs/key" },
        "mode": { "enum": ["enforce", "observe"] },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" }, "minItems": 1, "maxItems": 100 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" }, "maxItems": 400 },
        "layout": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "appliesWhen": { "$ref": "#/$defs/condition", "description": "Which records the lifecycle is for (spec §6 applies to)." },
        "reset": {
          "description": "Lets people start a record's workflow over (spec §6 reset).",
          "type": "object",
          "properties": {
            "label": { "type": "string", "maxLength": 80 },
            "to": { "$ref": "#/$defs/id" },
            "who": { "$ref": "#/$defs/assignees" },
            "confirm": { "type": "string", "maxLength": 500 },
            "input": {
              "type": "object",
              "required": ["form"],
              "properties": { "form": { "$ref": "#/$defs/formDefinition" } },
              "additionalProperties": false
            },
            "runExitEnter": { "type": "boolean" },
            "cancelAutomations": { "type": "boolean" },
            "steps": { "$ref": "#/$defs/steps" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "key", "label", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "enum": ["initial", "active", "terminal"] },
        "tone": { "enum": ["neutral", "info", "success", "warning", "danger"] },
        "description": { "type": "string", "maxLength": 2000 },
        "onEnter": { "$ref": "#/$defs/steps" },
        "onExit": { "$ref": "#/$defs/steps" },
        "keepRunsOnExit": { "type": "boolean" },
        "sla": {
          "type": "object",
          "required": ["within", "steps"],
          "properties": {
            "within": { "$ref": "#/$defs/duration" },
            "calendar": { "$ref": "#/$defs/calendar" },
            "steps": { "$ref": "#/$defs/steps" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "key", "label", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "from": { "anyOf": [{ "const": "*" }, { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }] },
        "to": { "$ref": "#/$defs/id" },
        "who": { "$ref": "#/$defs/assignees" },
        "when": { "$ref": "#/$defs/condition" },
        "input": {
          "type": "object",
          "required": ["form"],
          "properties": { "form": { "$ref": "#/$defs/formDefinition" } },
          "additionalProperties": false
        },
        "steps": { "$ref": "#/$defs/steps" },
        "auto": {
          "oneOf": [
            {
              "type": "object",
              "required": ["after"],
              "properties": { "after": { "$ref": "#/$defs/duration" }, "calendar": { "$ref": "#/$defs/calendar" } },
              "additionalProperties": false
            },
            { "type": "object", "required": ["when"], "properties": { "when": { "$ref": "#/$defs/condition" } }, "additionalProperties": false }
          ]
        },
        "confirm": { "type": "string", "maxLength": 500 },
        "tone": { "enum": ["neutral", "primary", "success", "warning", "danger"] },
        "hidden": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" }, "maxItems": 200 },
    "stepList": {
      "type": "object",
      "required": ["id", "steps"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "steps": { "$ref": "#/$defs/steps" } },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": ["max"],
      "properties": {
        "max": { "type": "integer", "minimum": 0, "maximum": 10 },
        "backoff": { "enum": ["fixed", "exponential"] },
        "initial": { "$ref": "#/$defs/duration" },
        "maxDelay": { "$ref": "#/$defs/duration" }
      },
      "additionalProperties": false
    },
    "onError": {
      "oneOf": [
        { "enum": ["stop", "continue"] },
        { "type": "object", "required": ["steps"], "properties": { "steps": { "$ref": "#/$defs/steps" } }, "additionalProperties": false }
      ]
    },
    "stepBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 2000 },
        "disabled": { "type": "boolean" },
        "retry": { "$ref": "#/$defs/retry" },
        "timeout": { "$ref": "#/$defs/duration" },
        "onError": { "$ref": "#/$defs/onError" }
      }
    },
    "step": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "oneOf": [
        { "$ref": "#/$defs/branchStep" },
        { "$ref": "#/$defs/switchStep" },
        { "$ref": "#/$defs/parallelStep" },
        { "$ref": "#/$defs/forEachStep" },
        { "$ref": "#/$defs/approvalStep" },
        { "$ref": "#/$defs/taskStep" },
        { "$ref": "#/$defs/waitStep" },
        { "$ref": "#/$defs/setFieldsStep" },
        { "$ref": "#/$defs/createRecordStep" },
        { "$ref": "#/$defs/setVariablesStep" },
        { "$ref": "#/$defs/applyTransitionStep" },
        { "$ref": "#/$defs/notifyStep" },
        { "$ref": "#/$defs/webhookStep" },
        { "$ref": "#/$defs/actionStep" },
        { "$ref": "#/$defs/subWorkflowStep" },
        { "$ref": "#/$defs/goToStep" },
        { "$ref": "#/$defs/endStep" }
      ]
    },
    "branchStep": {
      "type": "object",
      "required": ["type", "paths"],
      "properties": {
        "type": { "const": "branch" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "label", "when", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "when": { "$ref": "#/$defs/condition" },
              "steps": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        },
        "otherwise": { "$ref": "#/$defs/stepList" }
      }
    },
    "switchStep": {
      "type": "object",
      "required": ["type", "on", "cases"],
      "properties": {
        "type": { "const": "switch" },
        "on": { "$ref": "#/$defs/tokenPath" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["id", "label", "values", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "values": { "type": "array", "minItems": 1 },
              "steps": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        },
        "otherwise": { "$ref": "#/$defs/stepList" }
      }
    },
    "parallelStep": {
      "type": "object",
      "required": ["type", "paths", "join"],
      "properties": {
        "type": { "const": "parallel" },
        "paths": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/stepList" } },
        "join": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "enum": ["all", "any", "count"] }, "count": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      }
    },
    "forEachStep": {
      "type": "object",
      "required": ["type", "collection", "steps", "max"],
      "properties": {
        "type": { "const": "forEach" },
        "collection": { "$ref": "#/$defs/tokenPath" },
        "when": { "$ref": "#/$defs/condition" },
        "mode": { "enum": ["sequential", "parallel"] },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max": { "type": "integer", "minimum": 1, "maximum": 500 },
        "steps": { "$ref": "#/$defs/steps" }
      }
    },
    "approvalStep": {
      "type": "object",
      "required": ["type", "assignees", "rule", "due", "outcomes"],
      "properties": {
        "type": { "const": "approval" },
        "assignees": { "$ref": "#/$defs/assignees" },
        "rule": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "enum": ["any", "all", "count", "percent"] }, "value": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        "due": { "$ref": "#/$defs/duration" },
        "calendar": { "$ref": "#/$defs/calendar" },
        "reminders": { "type": "array", "items": { "$ref": "#/$defs/duration" }, "maxItems": 10 },
        "escalation": {
          "type": "object",
          "required": ["after", "assignees"],
          "properties": {
            "after": { "$ref": "#/$defs/duration" },
            "assignees": { "$ref": "#/$defs/assignees" },
            "notify": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "form": { "$ref": "#/$defs/formDefinition" },
        "instructions": { "$ref": "#/$defs/template" },
        "allowDelegation": { "type": "boolean" },
        "requireComment": { "enum": ["never", "reject", "always"] },
        "outcomes": {
          "type": "object",
          "required": ["approved", "rejected", "timedOut"],
          "properties": {
            "approved": { "$ref": "#/$defs/steps" },
            "rejected": { "$ref": "#/$defs/steps" },
            "timedOut": { "$ref": "#/$defs/steps" }
          },
          "additionalProperties": false
        }
      }
    },
    "taskStep": {
      "type": "object",
      "required": ["type", "assignees", "due", "outcomes", "onTimeout"],
      "properties": {
        "type": { "const": "task" },
        "assignees": { "$ref": "#/$defs/assignees" },
        "due": { "$ref": "#/$defs/duration" },
        "calendar": { "$ref": "#/$defs/calendar" },
        "reminders": { "type": "array", "items": { "$ref": "#/$defs/duration" }, "maxItems": 10 },
        "escalation": { "$ref": "#/$defs/approvalStep/properties/escalation" },
        "form": { "$ref": "#/$defs/formDefinition" },
        "instructions": { "$ref": "#/$defs/template" },
        "allowDelegation": { "type": "boolean" },
        "requireComment": { "enum": ["never", "always"] },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "key", "label", "steps"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "key": { "$ref": "#/$defs/key" },
              "label": { "type": "string" },
              "tone": { "enum": ["neutral", "primary", "success", "warning", "danger"] },
              "steps": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        },
        "onTimeout": { "$ref": "#/$defs/stepList" }
      }
    },
    "waitStep": {
      "type": "object",
      "required": ["type", "until"],
      "properties": {
        "type": { "const": "wait" },
        "until": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "duration"],
              "properties": { "type": { "const": "duration" }, "duration": { "$ref": "#/$defs/duration" }, "calendar": { "$ref": "#/$defs/calendar" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "date"],
              "properties": {
                "type": { "const": "date" },
                "date": { "$ref": "#/$defs/operand" },
                "offset": { "$ref": "#/$defs/duration" },
                "at": { "$ref": "#/$defs/trigger/properties/at" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "when", "timeout", "onTimeout"],
              "properties": {
                "type": { "const": "condition" },
                "when": { "$ref": "#/$defs/condition" },
                "timeout": { "$ref": "#/$defs/duration" },
                "onTimeout": { "$ref": "#/$defs/stepList" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "signal"],
              "properties": {
                "type": { "const": "signal" },
                "signal": { "$ref": "#/$defs/key" },
                "timeout": { "$ref": "#/$defs/duration" },
                "onTimeout": { "$ref": "#/$defs/stepList" }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "setFieldsStep": {
      "type": "object",
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "setFields" },
        "target": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["field", "value"],
            "properties": { "field": { "$ref": "#/$defs/key" }, "value": { "$ref": "#/$defs/operand" } },
            "additionalProperties": false
          }
        }
      }
    },
    "createRecordStep": {
      "type": "object",
      "required": ["type", "entity", "values"],
      "properties": {
        "type": { "const": "createRecord" },
        "entity": { "$ref": "#/$defs/key" },
        "values": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["field", "value"],
            "properties": { "field": { "$ref": "#/$defs/key" }, "value": { "$ref": "#/$defs/operand" } },
            "additionalProperties": false
          }
        }
      }
    },
    "setVariablesStep": {
      "type": "object",
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "setVariables" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variable", "value"],
            "properties": { "variable": { "$ref": "#/$defs/id" }, "value": { "$ref": "#/$defs/operand" } },
            "additionalProperties": false
          }
        }
      }
    },
    "applyTransitionStep": {
      "type": "object",
      "required": ["type", "lifecycle", "transition"],
      "properties": {
        "type": { "const": "applyTransition" },
        "target": { "type": "string" },
        "lifecycle": { "$ref": "#/$defs/key" },
        "transition": { "$ref": "#/$defs/key" },
        "input": { "type": "object", "additionalProperties": { "$ref": "#/$defs/operand" } },
        "ifNotAllowed": { "enum": ["fail", "skip"] }
      }
    },
    "notifyStep": {
      "type": "object",
      "required": ["type", "channel", "to", "body"],
      "properties": {
        "type": { "const": "notify" },
        "channel": { "$ref": "#/$defs/key" },
        "to": { "type": "array", "items": { "$ref": "#/$defs/recipient" }, "minItems": 1, "maxItems": 50 },
        "subject": { "$ref": "#/$defs/template" },
        "body": { "$ref": "#/$defs/template" },
        "link": { "anyOf": [{ "const": "record" }, { "$ref": "#/$defs/template" }] }
      }
    },
    "webhookStep": {
      "type": "object",
      "required": ["type", "method"],
      "properties": {
        "type": { "const": "webhook" },
        "connection": { "$ref": "#/$defs/key" },
        "url": { "type": "string", "format": "uri" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "$ref": "#/$defs/template" },
        "headers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/template" } },
        "body": true,
        "expect": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
      }
    },
    "actionStep": {
      "type": "object",
      "required": ["type", "action"],
      "properties": {
        "type": { "const": "action" },
        "action": { "$ref": "#/$defs/key" },
        "input": { "type": "object", "additionalProperties": { "$ref": "#/$defs/operand" } }
      }
    },
    "subWorkflowStep": {
      "type": "object",
      "required": ["type", "workflow", "wait"],
      "properties": {
        "type": { "const": "subWorkflow" },
        "workflow": { "$ref": "#/$defs/key" },
        "target": { "type": "string" },
        "wait": { "type": "boolean" },
        "input": { "type": "object", "additionalProperties": { "$ref": "#/$defs/operand" } }
      }
    },
    "goToStep": {
      "type": "object",
      "required": ["type", "target", "maxTimes"],
      "properties": {
        "type": { "const": "goTo" },
        "target": { "$ref": "#/$defs/id" },
        "maxTimes": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "endStep": {
      "type": "object",
      "required": ["type", "result"],
      "properties": {
        "type": { "const": "end" },
        "result": { "enum": ["completed", "failed"] },
        "reason": { "$ref": "#/$defs/template" }
      }
    }
  }
}
